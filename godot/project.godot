; Engine configuration file.
; Minimal Godot 4 project for embedded and standalone scene previews.

config_version=5

[application]
config/name="SamathaScopeScenes"
run/main_scene="res://scenes/Main.tscn"
config/use_hidden_project_data_directory=false

[autoload]
SceneParamBus="*res://autoload/SceneParamBus.gd"
ScenePreviewDriver="*res://autoload/ScenePreviewDriver.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="mobile"
